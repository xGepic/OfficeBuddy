<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="PdfManager.App.Controls.ToolShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:ConnectionId='2' x:Name="Root" AllowDrop="True" Background="Transparent" Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='8' x:Name="BackButton" x:Uid="ToolShellBackButton"                    Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock x:Uid="ToolShellBack" />
                </StackPanel>
            </Button>

            <TextBlock x:ConnectionId='9'
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                                                  
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='10' x:Name="UndoButton" x:Uid="ToolShellUndoButton"                    IsEnabled="False" Padding="14,8">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                        <TextBlock x:Uid="ToolShellUndo" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='11' x:Name="RedoButton" x:Uid="ToolShellRedoButton"                    IsEnabled="False" Padding="14,8">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                        <TextBlock x:Uid="ToolShellRedo" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='12' x:Name="OpenButton" x:Uid="ToolShellOpenButton"                    Margin="12,0,0,0" Padding="18,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="18" />
                        <TextBlock x:Uid="ToolShellOpen" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:ConnectionId='3' x:Name="MessageBar" Grid.Row="1" IsOpen="False" />

        <ContentPresenter x:ConnectionId='4' Grid.Row="2"                                      />

        <ContentPresenter x:ConnectionId='5' Grid.Row="3"                                        />

        <!-- Blocks input as soon as it is visible; fades in only when the work takes a moment. -->
        <Grid x:ConnectionId='6'
            x:Name="BusyOverlay"
            Grid.Row="2"
            Grid.RowSpan="2"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,28"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Spacing="16">
                <ProgressRing Width="48" Height="48" IsActive="True" />
                <TextBlock x:ConnectionId='7' x:Name="BusyText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

