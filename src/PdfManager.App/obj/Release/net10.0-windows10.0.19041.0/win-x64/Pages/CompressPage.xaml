<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PdfManager.App.Pages.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <controls:ToolShell x:ConnectionId='2' x:Name="Shell"                                                                    >
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel x:ConnectionId='3'
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE73F;" />
                    <TextBlock
                        x:Uid="OpenDocumentHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:ConnectionId='4'
                    x:Name="DocumentArea"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="620"
                    Spacing="28"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:ConnectionId='9'
                                                           
                                                             
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <FontIcon x:ConnectionId='12'
                                x:Name="ThumbnailPlaceholder"
                                FontSize="40"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xEA90;" />
                            <Image x:ConnectionId='13' x:Name="Thumbnail" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:ConnectionId='10' x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:ConnectionId='11' x:Name="InfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:ConnectionId='5' x:Name="StatusText" TextWrapping="Wrap" />

                    <StackPanel x:ConnectionId='6' x:Name="ResultPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:ConnectionId='7' x:Name="SizesText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:ConnectionId='8' x:Name="ResultText" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button x:ConnectionId='14'
                    x:Name="CompressButton"
                                          
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE73F;" />
                        <TextBlock x:ConnectionId='17' x:Name="CompressButtonText" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='15'
                    x:Name="SaveAsPartsButton"
                    x:Uid="CompressSaveAsPartsButton"
                                             
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE8C6;" />
                        <TextBlock x:Uid="CompressSaveAsParts" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='16'
                    x:Name="SaveButton"
                    x:Uid="CompressSaveButton"
                                      
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="CompressSave" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>

