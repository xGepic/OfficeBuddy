<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PdfManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Somewhat larger than the WinUI default of 14, for comfortable reading. -->
            <x:Double x:Key="ControlContentThemeFontSize">16</x:Double>
            <x:Double x:Key="ContentControlFontSize">16</x:Double>
            <x:Double x:Key="BodyTextBlockFontSize">16</x:Double>
            <x:Double x:Key="BodyStrongTextBlockFontSize">16</x:Double>
            <x:Double x:Key="CaptionTextBlockFontSize">14</x:Double>
            <x:Double x:Key="InfoBarTitleFontSize">16</x:Double>
            <x:Double x:Key="InfoBarMessageFontSize">16</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>

