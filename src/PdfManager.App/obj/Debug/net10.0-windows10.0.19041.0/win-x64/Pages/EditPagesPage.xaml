<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdfManager.App.Pages.EditPagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <controls:ToolShell x:ConnectionId='2' x:Name="Shell"                                                                    >
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel x:ConnectionId='3'
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        x:Uid="OpenDocumentHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:ConnectionId='4' x:Name="PagesArea" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar x:ConnectionId='5'
                        x:Name="BlankPagesBanner"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='7' x:Name="RotateLeftButton" x:Uid="EditPagesRotateLeftButton"                          Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE7AD;" />
                                <TextBlock x:Uid="EditPagesRotateLeft" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='8' x:Name="RotateRightButton" x:Uid="EditPagesRotateRightButton"                           Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- The same circular arrow, mirrored. -->
                                <FontIcon FontSize="16" Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <TextBlock x:Uid="EditPagesRotateRight" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='9' x:Name="RemoveButton"                      Margin="12,0,0,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='10' x:Name="RemoveIcon" FontSize="16" Glyph="&#xE74D;" />
                                <TextBlock x:ConnectionId='11' x:Name="RemoveText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Uid="EditPagesHint"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <controls:PageGrid x:ConnectionId='6'
                        x:Name="PageThumbnails"
                        Grid.Row="3"
                                                            
                                                                          
                                                                       />
                </Grid>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:ConnectionId='12'
                    x:Name="AllRemovedHint"
                    x:Uid="EditPagesAllRemoved"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button x:ConnectionId='13'
                    x:Name="SaveButton"
                    x:Uid="EditPagesSaveButton"
                    Grid.Column="1"
                                      
                    IsEnabled="False"
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="EditPagesSave" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>

