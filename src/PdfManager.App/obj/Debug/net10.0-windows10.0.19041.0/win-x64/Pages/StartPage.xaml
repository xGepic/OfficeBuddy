<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="PdfManager.App.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PdfManager.App"
    xmlns:controls="using:PdfManager.App.Controls">

    <ScrollViewer x:ConnectionId='2'
        x:Name="Scroller"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
                                        >
        <Grid x:ConnectionId='3'
            x:Name="PageContent"
            MaxWidth="1360"
            Padding="40,28,40,32"
            RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:ConnectionId='4' x:Name="Header"                                  Spacing="4">
                <TextBlock x:Uid="StartHeading" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    x:Uid="StartSubheading"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl x:ConnectionId='5'
                x:Name="TileList"
                Grid.Row="1"
                IsTabStop="False"
                                            >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TileGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate                          >
                        <Button x:ConnectionId='7'
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                                                            
                                                                     
                                              
                            CornerRadius="8"
                                                    
                                            
                                                            
                            Padding="20,18"
                                          >
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:ConnectionId='8'
                                    VerticalAlignment="Top"
                                    FontSize="36"
                                                           />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:ConnectionId='9'
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                                            
                                        TextWrapping="Wrap" />
                                    <TextBlock x:ConnectionId='10'                             TextWrapping="Wrap" />
                                    <TextBlock x:ConnectionId='11'
                                        FontStyle="Italic"
                                                                      
                                                                                   />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>

