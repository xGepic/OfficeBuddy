<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="PdfManager.App.Controls.PageGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <Grid>
        <GridView x:ConnectionId='2'
            x:Name="Thumbnails"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
                                                  
                                                              
                                                            
                                        
                                                          
            IsMultiSelectCheckBoxEnabled="False"
            SelectionMode="Extended">
            <GridView.ItemTemplate>
                <DataTemplate                                    >
                    <!-- Named here, at the root, so the grid item itself is announced as "Seite 3". -->
                    <Grid x:ConnectionId='13'                                                                 >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Width="184"
                            Padding="8"
                            Spacing="6">
                            <Grid Width="168" Height="168">
                                <FontIcon x:ConnectionId='21'
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A5;"
                                                                                             />
                                <!-- Square box, so a Page still fits after rotating it by 90°. -->
                                <Image x:ConnectionId='22'
                                                                                
                                    RenderTransformOrigin="0.5,0.5"
                                                                        
                                    Stretch="Uniform">
                                    <Image.RenderTransform>
                                        <RotateTransform x:ConnectionId='25'                                        />
                                    </Image.RenderTransform>
                                </Image>
                                <FontIcon x:ConnectionId='23'
                                    FontSize="72"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE711;"
                                                                                             />
                                <!-- A clear tick on selected Pages, on top of the grid's own highlight. -->
                                <Border x:ConnectionId='24'
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                                                                               >
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;" />
                                </Border>
                            </Grid>
                            <TextBlock x:ConnectionId='17' HorizontalAlignment="Center"                                />
                            <!-- Split: which Part this Page goes into. -->
                            <StackPanel x:ConnectionId='18' Spacing="2"                                                      >
                                <Border x:ConnectionId='19' Height="10"                                              CornerRadius="5" />
                                <TextBlock x:ConnectionId='20'
                                    FontWeight="SemiBold"
                                                                                
                                                                           />
                            </StackPanel>
                        </StackPanel>
                        <!-- Split: the gap after this Page, where a click places or removes a Split point. -->
                        <Button x:ConnectionId='14'
                            Grid.Column="1"
                            Width="36"
                            Height="184"
                            Padding="0"
                            VerticalAlignment="Top"
                                                                                      
                            Background="Transparent"
                            BorderThickness="0"
                                             
                                                                                   
                                                                            >
                            <Grid>
                                <Rectangle x:ConnectionId='15'
                                    Width="2"
                                    Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                   />
                                <Border x:ConnectionId='16'
                                    Width="32"
                                    Height="32"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    CornerRadius="16"
                                                                                         >
                                    <FontIcon FontSize="20" Glyph="&#xE8C6;" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Popup x:ConnectionId='3' x:Name="PreviewPopup">
            <Grid x:ConnectionId='4'
                x:Name="PreviewRoot"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                             
                                           >
                <Grid x:ConnectionId='5'
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="8"
                    RowSpacing="12"
                                               >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='10'
                            x:Name="PreviewTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:ConnectionId='11'
                            x:Name="PreviewCloseButton"
                            x:Uid="PreviewCloseButton"
                            Grid.Column="1"
                                                      
                            Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                                <TextBlock x:Uid="PreviewClose" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:ConnectionId='6' x:Name="PreviewBox" Grid.Row="1">
                        <ProgressRing x:ConnectionId='7'
                            x:Name="PreviewProgress"
                            Width="48"
                            Height="48"
                            IsActive="False" />
                        <Image x:ConnectionId='8' x:Name="PreviewImage" RenderTransformOrigin="0.5,0.5" Stretch="Uniform">
                            <Image.RenderTransform>
                                <RotateTransform x:ConnectionId='9' x:Name="PreviewRotation" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </Popup>
    </Grid>
</UserControl>

