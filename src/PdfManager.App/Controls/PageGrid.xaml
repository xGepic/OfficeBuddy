<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PdfManager.App.Controls.PageGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <Grid>
        <GridView
            x:Name="Thumbnails"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DoubleTapped="Thumbnails_DoubleTapped"
            DragItemsCompleted="Thumbnails_DragItemsCompleted"
            DragItemsStarting="Thumbnails_DragItemsStarting"
            ItemsSource="{x:Bind Items}"
            SelectionChanged="Thumbnails_SelectionChanged"
            IsMultiSelectCheckBoxEnabled="False"
            SelectionMode="Extended">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="controls:PageThumbnail">
                    <!-- Named here, at the root, so the grid item itself is announced as "Seite 3". -->
                    <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Width="184"
                            Padding="8"
                            Spacing="6">
                            <Grid Width="168" Height="168">
                                <FontIcon
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A5;"
                                    Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                <!-- Square box, so a Page still fits after rotating it by 90°. -->
                                <Image
                                    Opacity="{x:Bind ImageOpacity, Mode=OneWay}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="{x:Bind Image, Mode=OneWay}"
                                    Stretch="Uniform">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                                    </Image.RenderTransform>
                                </Image>
                                <FontIcon
                                    FontSize="72"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE711;"
                                    Visibility="{x:Bind RemovalMarkVisibility, Mode=OneWay}" />
                                <!-- A clear tick on selected Pages, on top of the grid's own highlight. -->
                                <Border
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Visibility="{x:Bind SelectionBadgeVisibility, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;" />
                                </Border>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" Text="{x:Bind PageNumberText}" />
                            <!-- Split: which Part this Page goes into. -->
                            <StackPanel Spacing="2" Visibility="{x:Bind PartBandVisibility, Mode=OneWay}">
                                <Border Height="10" Background="{x:Bind PartBrush, Mode=OneWay}" CornerRadius="5" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind PartBrush, Mode=OneWay}"
                                    Text="{x:Bind PartLabel, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- Split: the gap after this Page, where a click places or removes a Split point. -->
                        <Button
                            Grid.Column="1"
                            Width="36"
                            Height="184"
                            Padding="0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{x:Bind GapLabel, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Gap_Click"
                            ToolTipService.ToolTip="{x:Bind GapLabel, Mode=OneWay}"
                            Visibility="{x:Bind GapVisibility, Mode=OneWay}">
                            <Grid>
                                <Rectangle
                                    Width="2"
                                    Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                    Opacity="{x:Bind GapLineOpacity, Mode=OneWay}" />
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    CornerRadius="16"
                                    Visibility="{x:Bind ScissorsVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="20" Glyph="&#xE8C6;" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Popup x:Name="PreviewPopup">
            <Grid
                x:Name="PreviewRoot"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                KeyDown="PreviewRoot_KeyDown"
                Tapped="PreviewRoot_Tapped">
                <Grid
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="8"
                    RowSpacing="12"
                    Tapped="PreviewCard_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PreviewTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="PreviewCloseButton"
                            x:Uid="PreviewCloseButton"
                            Grid.Column="1"
                            Click="PreviewClose_Click"
                            Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                                <TextBlock x:Uid="PreviewClose" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="PreviewBox" Grid.Row="1">
                        <ProgressRing
                            x:Name="PreviewProgress"
                            Width="48"
                            Height="48"
                            IsActive="False" />
                        <Image x:Name="PreviewImage" RenderTransformOrigin="0.5,0.5" Stretch="Uniform">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="PreviewRotation" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
