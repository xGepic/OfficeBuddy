<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdfManager.App.Pages.ResizeImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE740;" />
                    <TextBlock
                        x:Uid="ResizeImageEmptyHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer x:Name="ImageArea" Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="620"
                        Spacing="28">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="{x:Bind ThumbnailSize}"
                                Height="{x:Bind ThumbnailSize}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <FontIcon
                                    x:Name="ThumbnailPlaceholder"
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xEB9F;" />
                                <Image x:Name="Thumbnail" Stretch="Uniform" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OriginalSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="12">
                            <RadioButton
                                x:Name="ByPercentage"
                                x:Uid="ResizeByPercentage"
                                Checked="Mode_Checked"
                                GroupName="ResizeMode" />
                            <StackPanel Margin="28,0,0,0" Orientation="Horizontal" Spacing="12">
                                <NumberBox
                                    x:Name="PercentageBox"
                                    x:Uid="ResizePercentageBox"
                                    Width="150"
                                    LargeChange="25"
                                    Maximum="1000"
                                    Minimum="1"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="PercentageBox_ValueChanged" />
                                <TextBlock
                                    x:Uid="ResizePercentageHint"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <RadioButton
                                x:Name="ByPixels"
                                x:Uid="ResizeByPixels"
                                Margin="0,12,0,0"
                                Checked="Mode_Checked"
                                GroupName="ResizeMode" />
                            <StackPanel Margin="28,0,0,0" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <NumberBox
                                        x:Name="WidthBox"
                                        x:Uid="ResizeWidthBox"
                                        Width="170"
                                        LargeChange="100"
                                        Maximum="50000"
                                        Minimum="1"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="WidthBox_ValueChanged" />
                                    <NumberBox
                                        x:Name="HeightBox"
                                        x:Uid="ResizeHeightBox"
                                        Width="170"
                                        LargeChange="100"
                                        Maximum="50000"
                                        Minimum="1"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="HeightBox_ValueChanged" />
                                </StackPanel>
                                <CheckBox x:Name="KeepProportions" x:Uid="ResizeKeepProportions" IsChecked="True" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="NewSizeText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Button
                x:Name="SaveButton"
                x:Uid="ResizeImageSaveButton"
                HorizontalAlignment="Right"
                Click="Save_Click"
                IsEnabled="False"
                Padding="24,10"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE74E;" />
                    <TextBlock x:Uid="ResizeImageSave" />
                </StackPanel>
            </Button>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
