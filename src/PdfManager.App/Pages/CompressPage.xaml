<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdfManager.App.Pages.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE73F;" />
                    <TextBlock
                        x:Uid="OpenDocumentHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="DocumentArea"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="620"
                    Spacing="28"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="{x:Bind ThumbnailWidth}"
                            Height="{x:Bind ThumbnailHeight}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <FontIcon
                                x:Name="ThumbnailPlaceholder"
                                FontSize="40"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xEA90;" />
                            <Image x:Name="Thumbnail" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="InfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />

                    <StackPanel x:Name="ResultPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="SizesText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="CompressButton"
                    Click="Compress_Click"
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE73F;" />
                        <TextBlock x:Name="CompressButtonText" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="SaveButton"
                    x:Uid="CompressSaveButton"
                    Click="Save_Click"
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="CompressSave" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
