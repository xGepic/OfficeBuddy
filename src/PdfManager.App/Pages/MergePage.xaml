<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdfManager.App.Pages.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PdfManager.App.Controls"
    xmlns:pages="using:PdfManager.App.Pages">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8C8;" />
                    <TextBlock
                        x:Uid="MergeEmptyHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="ListArea" RowSpacing="8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="MergeOrderHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView
                        x:Name="DocumentList"
                        Grid.Row="1"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="DocumentList_DragItemsCompleted"
                        DragItemsStarting="DocumentList_DragItemsStarting"
                        ItemsSource="{x:Bind Cards}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:MergeCard">
                                <Grid
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        MinWidth="28"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind PositionText}" />
                                    <Grid Grid.Column="1" Width="48" Height="64">
                                        <FontIcon
                                            FontSize="32"
                                            Glyph="&#xEA90;"
                                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PageCountText}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                                        Click="Remove_Click"
                                        Padding="10"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                        <FontIcon FontSize="18" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="NeedTwoHint"
                    x:Uid="MergeNeedTwo"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="SaveButton"
                    x:Uid="MergeSaveButton"
                    Grid.Column="1"
                    Click="Save_Click"
                    IsEnabled="False"
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="MergeSave" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
