<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeBuddy.App.Pages.EditPagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OfficeBuddy.App.Controls">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        x:Uid="OpenDocumentHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="PagesArea" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        x:Name="BlankPagesBanner"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RotateLeftButton" x:Uid="EditPagesRotateLeftButton" Click="RotateLeft_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE7AD;" />
                                <TextBlock x:Uid="EditPagesRotateLeft" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RotateRightButton" x:Uid="EditPagesRotateRightButton" Click="RotateRight_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- The same circular arrow, mirrored. -->
                                <FontIcon FontSize="16" Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <TextBlock x:Uid="EditPagesRotateRight" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveButton" Click="Remove_Click" Margin="12,0,0,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="RemoveIcon" FontSize="16" Glyph="&#xE74D;" />
                                <TextBlock x:Name="RemoveText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Uid="EditPagesHint"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <controls:PageGrid
                        x:Name="PageThumbnails"
                        Grid.Row="3"
                        PageMoved="PageThumbnails_PageMoved"
                        SelectionChanged="PageThumbnails_SelectionChanged"
                        SeveralDragged="PageThumbnails_SeveralDragged" />
                </Grid>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="AllRemovedHint"
                    x:Uid="EditPagesAllRemoved"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="SaveButton"
                    x:Uid="EditPagesSaveButton"
                    Grid.Column="1"
                    Click="Save_Click"
                    IsEnabled="False"
                    Padding="24,10"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="EditPagesSave" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
