<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeBuddy.App.Pages.PdfPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OfficeBuddy.App.Controls">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        x:Uid="PdfPasswordEmptyHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer x:Name="DocumentArea" Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560"
                        Spacing="24">
                        <Grid
                            Padding="20,16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="LockIcon" FontSize="32" Glyph="&#xE72E;" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PagesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <RadioButtons x:Name="ProtectedChoice" SelectionChanged="ProtectedChoice_SelectionChanged">
                            <RadioButton x:Uid="PdfPasswordRemove" />
                            <RadioButton x:Uid="PdfPasswordChange" />
                        </RadioButtons>

                        <StackPanel x:Name="NewPasswordPanel" Spacing="12">
                            <PasswordBox
                                x:Name="NewPasswordBox"
                                x:Uid="PdfPasswordNewBox"
                                Width="320"
                                HorizontalAlignment="Left"
                                PasswordChanged="Password_Changed" />
                            <PasswordBox
                                x:Name="RepeatPasswordBox"
                                x:Uid="PdfPasswordRepeatBox"
                                Width="320"
                                HorizontalAlignment="Left"
                                PasswordChanged="Password_Changed" />
                            <TextBlock
                                x:Name="MismatchText"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Uid="PdfPasswordWarning"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Button
                x:Name="SaveButton"
                HorizontalAlignment="Right"
                Click="Save_Click"
                IsEnabled="False"
                Padding="24,10"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE74E;" />
                    <TextBlock x:Name="SaveText" />
                </StackPanel>
            </Button>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
