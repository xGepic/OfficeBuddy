<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeBuddy.App.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OfficeBuddy.App.Controls"
    xmlns:pages="using:OfficeBuddy.App.Pages">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Scanner, where the paper lies, and the button: always at hand, for more Pages too. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="ScannerChoice"
                        x:Uid="ScanScanner"
                        MinWidth="220"
                        SelectionChanged="ScannerChoice_SelectionChanged" />
                    <ComboBox
                        x:Name="SourceChoice"
                        Grid.Column="1"
                        x:Uid="ScanSource"
                        MinWidth="260" />
                    <Button
                        x:Name="ScanButton"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Click="Scan_Click"
                        Padding="24,10"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE8FE;" />
                            <TextBlock x:Name="ScanText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8FE;" />
                    <TextBlock
                        x:Name="EmptyHint"
                        x:Uid="ScanEmptyHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="ListArea" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="ScanOrderHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <ListView
                        x:Name="PageList"
                        Grid.Row="1"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="PageList_DragItemsCompleted"
                        DragItemsStarting="PageList_DragItemsStarting"
                        ItemsSource="{x:Bind Cards}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ImageCard">
                                <Grid
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        MinWidth="28"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind PositionText}" />
                                    <Grid Grid.Column="1" Width="64" Height="64">
                                        <FontIcon
                                            FontSize="32"
                                            Glyph="&#xEB9F;"
                                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="{x:Bind RotateLabel}"
                                        Click="Rotate_Click"
                                        Padding="10"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind RotateLabel}">
                                        <!-- The circular arrow, mirrored to turn right. -->
                                        <FontIcon FontSize="18" Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <ScaleTransform ScaleX="-1" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Button>
                                    <Button
                                        Grid.Column="4"
                                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                                        Click="Remove_Click"
                                        Padding="10"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                        <FontIcon FontSize="18" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Button
                x:Name="SaveButton"
                x:Uid="ScanSaveButton"
                HorizontalAlignment="Right"
                Click="Save_Click"
                IsEnabled="False"
                Padding="24,10"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE74E;" />
                    <TextBlock x:Uid="ScanSave" />
                </StackPanel>
            </Button>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
