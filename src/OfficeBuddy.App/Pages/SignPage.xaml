<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeBuddy.App.Pages.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OfficeBuddy.App.Controls">

    <controls:ToolShell x:Name="Shell" BackRequested="Shell_BackRequested" FilesOpened="Shell_FilesOpened">
        <controls:ToolShell.Body>
            <Grid>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="16">
                    <FontIcon
                        FontSize="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEE56;" />
                    <TextBlock
                        x:Uid="SignEmptyHint"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="EditArea" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="140"
                            Height="56"
                            Padding="6"
                            Background="White"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Image x:Name="SignaturePreview" Stretch="Uniform" />
                        </Border>
                        <Button x:Name="ChooseSignatureButton" Grid.Column="1" Click="ChooseSignature_Click" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="18" Glyph="&#xEE56;" />
                                <TextBlock x:Name="ChooseSignatureText" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            x:Name="SignedOnText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        x:Name="HintText"
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- Room around the Page, so the grip on its edge can be grabbed. -->
                    <controls:PlacementStage
                        x:Name="Stage"
                        Grid.Row="2"
                        Margin="12"
                        PictureBackground="White"
                        Placed="Stage_Placed" />

                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="PreviousButton" Click="Previous_Click" Padding="12,8">
                            <FontIcon FontSize="16" Glyph="&#xE76B;" />
                        </Button>
                        <TextBlock
                            x:Name="PageText"
                            MinWidth="110"
                            VerticalAlignment="Center"
                            TextAlignment="Center" />
                        <Button x:Name="NextButton" Click="Next_Click" Padding="12,8">
                            <FontIcon FontSize="16" Glyph="&#xE76C;" />
                        </Button>
                        <Button
                            x:Name="SignHereButton"
                            x:Uid="SignHereButton"
                            Margin="16,0,0,0"
                            Click="SignHere_Click"
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Glyph="&#xEE56;" />
                                <TextBlock x:Uid="SignHere" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="RemoveHereButton"
                            x:Uid="SignRemoveHereButton"
                            Click="RemoveHere_Click"
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                <TextBlock x:Uid="SignRemoveHere" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </controls:ToolShell.Body>

        <controls:ToolShell.Footer>
            <Button
                x:Name="SaveButton"
                x:Uid="SignSaveButton"
                HorizontalAlignment="Right"
                Click="Save_Click"
                IsEnabled="False"
                Padding="24,10"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE74E;" />
                    <TextBlock x:Uid="SignSave" />
                </StackPanel>
            </Button>
        </controls:ToolShell.Footer>
    </controls:ToolShell>
</Page>
