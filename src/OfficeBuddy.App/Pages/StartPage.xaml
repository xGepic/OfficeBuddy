<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfficeBuddy.App.Pages.StartPage"
    Loaded="Page_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:OfficeBuddy.App"
    xmlns:controls="using:OfficeBuddy.App.Controls">

    <Page.Resources>
        <DataTemplate x:Key="HeadingTemplate" x:DataType="app:TileGroupHeader">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Title}" />
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" x:DataType="app:ToolTile">
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                AllowDrop="{x:Bind IsAvailable}"
                AutomationProperties.Name="{x:Bind Name}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Click="Tile_Click"
                CornerRadius="12"
                DragOver="Tile_DragOver"
                Drop="Tile_Drop"
                IsEnabled="{x:Bind IsAvailable}"
                Padding="20,18"
                Tag="{x:Bind}">
                <Button.Resources>
                    <!-- Hovered, a tile lights up blue at its edge. -->
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TileBackgroundPointerOverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TileBackgroundPressedBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentFillColorDefaultBrush" />
                </Button.Resources>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="60"
                        Height="60"
                        VerticalAlignment="Top"
                        Background="{ThemeResource TileIconBadgeBrush}"
                        CornerRadius="14">
                        <FontIcon
                            FontSize="30"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontStyle="Italic"
                            Text="{x:Bind ComingSoonText}"
                            Visibility="{x:Bind ComingSoonVisibility}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <controls:StartItemTemplateSelector
            x:Key="StartItemTemplates"
            Heading="{StaticResource HeadingTemplate}"
            Tile="{StaticResource TileTemplate}" />
    </Page.Resources>

    <ScrollViewer
        x:Name="Scroller"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        SizeChanged="Layout_SizeChanged">
        <Grid
            x:Name="PageContent"
            MaxWidth="1360"
            Padding="40,28,40,32"
            RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header" ColumnSpacing="20" SizeChanged="Layout_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="HeadingText"
                        x:Uid="StartHeading"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SubheadingText"
                        x:Uid="StartSubheading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <!-- Only with files the app was started with: back to every Tool. -->
                    <HyperlinkButton
                        x:Name="ShowAllButton"
                        x:Uid="StartShowAll"
                        Margin="-12,0,0,0"
                        Click="ShowAll_Click"
                        Visibility="Collapsed" />
                </StackPanel>
                <Button
                    x:Uid="StartSettingsButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="Settings_Click"
                    Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock x:Uid="StartSettings" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl
                x:Name="TileList"
                Grid.Row="1"
                IsTabStop="False"
                ItemTemplateSelector="{StaticResource StartItemTemplates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TileGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
