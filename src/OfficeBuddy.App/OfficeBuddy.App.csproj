<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OfficeBuddy.App</RootNamespace>
    <AssemblyName>OfficeBuddy</AssemblyName>
    <!-- Raise for every exe handed out; File Explorer shows it in the file's properties. -->
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shown for the exe: desktop and Start-menu shortcuts, Explorer. -->
    <ApplicationIcon>Assets\OfficeBuddy.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Not for MSIX: without it, dotnet publish leaves out the app's compiled XAML and resources. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The parts of the Microsoft.WindowsAppSDK 2.5.1 package the app uses, at the versions it pulls in.
      The whole package also brings AI, ML, Search and Widgets, which add over 20 MB to the exe.
      When upgrading, take the new versions from that package's dependencies.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also next to the exe, for the window: title bar, taskbar and Alt+Tab. -->
    <Content Include="Assets\OfficeBuddy.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeBuddy.Core\OfficeBuddy.Core.csproj" />
  </ItemGroup>

</Project>
