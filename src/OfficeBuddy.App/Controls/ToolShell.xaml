<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OfficeBuddy.App.Controls.ToolShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OfficeBuddy.App.Controls">

    <Grid x:Name="Root" AllowDrop="True" Background="Transparent" Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" x:Uid="ToolShellBackButton" Click="Back_Click" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock x:Uid="ToolShellBack" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="ToolShellHelpButton" Margin="0,0,12,0" Padding="14,8">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE897;" FontSize="16" />
                        <TextBlock x:Uid="ToolShellHelp" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <!-- Wider than a flyout's usual 456, and wrapping rather than scrolling sideways at any text size. -->
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="560" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Spacing="14">
                                <TextBlock x:Uid="ToolShellHelpHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ItemsControl x:Name="HelpStepList" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:HelpStep">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{x:Bind Number}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Text}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Uid="ToolShellHelpUndo"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="UndoButton" x:Uid="ToolShellUndoButton" Click="Undo_Click" IsEnabled="False" Padding="14,8">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                        <TextBlock x:Uid="ToolShellUndo" />
                    </StackPanel>
                </Button>
                <Button x:Name="RedoButton" x:Uid="ToolShellRedoButton" Click="Redo_Click" IsEnabled="False" Padding="14,8">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                        <TextBlock x:Uid="ToolShellRedo" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" x:Uid="ToolShellOpenButton" Click="Open_Click" Margin="12,0,0,0" Padding="18,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="18" />
                        <TextBlock x:Uid="ToolShellOpen" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" />

        <ContentPresenter Grid.Row="2" Content="{x:Bind Body, Mode=OneWay}" />

        <ContentPresenter Grid.Row="3" Content="{x:Bind Footer, Mode=OneWay}" />

        <!-- Blocks input as soon as it is visible; fades in only when the work takes a moment. -->
        <Grid
            x:Name="BusyOverlay"
            Grid.Row="2"
            Grid.RowSpan="2"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,28"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Spacing="16">
                <ProgressRing Width="48" Height="48" IsActive="True" />
                <TextBlock x:Name="BusyText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
